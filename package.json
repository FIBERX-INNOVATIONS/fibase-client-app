{
    "name": "fibase-client-app",
    "version": "1.0.22",
    "description": "Fibase Admin App – A modern, responsive dashboard for managing applications, roles, permissions, and members within the FiberX ecosystem. Built for performance and flexibility.",
    "private": true,
    "scripts": {
        "dev": "vite --config ./vite.config.mjs",
        "devcss": "npx @tailwindcss/cli -i ./public/assets/css/input.css -o ./public/assets/css/output.css --watch",
        "build": "vite build --config ./vite.config.mjs",
        "preview": "vite preview --config ./vite.config.mjs",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "lint": "eslint src vite.config.mjs tailwind.config.js postcss.config.mjs",
        "lint:fix": "eslint src vite.config.mjs tailwind.config.js postcss.config.mjs --fix",
        "precommit": "lint-staged",
        "prepare": "git config core.hooksPath .githooks",
        "typecheck": "vue-tsc --noEmit"
    },
    "author": "David Matt-Ojo",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fiberx-innovations/fiberx-dbms-client-app-client-app.git"
    },
    "homepage": "https://github.com/fiberx-innovations/fiberx-dbms-client-app-client-app#readme",
    "bugs": {
        "url": "https://github.com/fiberx-innovations/fiberx-dbms-client-app-client-app/issues"
    },
    "keywords": [
        "Fibase",
        "Admin Panel",
        "Application Management",
        "Role-Based Access Control",
        "Permissions Dashboard",
        "User Management",
        "Feature Flags",
        "Web App Admin",
        "Admin Dashboard",
        "Access Control System",
        "App Permissions Manager",
        "Member Management",
        "Role Management",
        "Secure Admin Interface",
        "Enterprise Admin Panel",
        "SaaS Dashboard",
        "FiberX Admin",
        "Developer Tools",
        "App Infrastructure Management"
    ],
    "dependencies": {
        "@tailwindcss/cli": "^4.1.11",
        "@tailwindcss/postcss": "^4.1.8",
        "@tailwindcss/vite": "^4.1.8",
        "@vuepic/vue-datepicker": "^12.1.0",
        "axios": "^1.12.2",
        "dayjs": "^1.11.18",
        "js-cookie": "^3.0.5",
        "mitt": "^3.0.1",
        "qrcode": "^1.5.4",
        "vue": "^3.5.17",
        "vue-router": "^4.5.1",
        "vue3-tel-input": "^1.0.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.6.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "eslint": "^10.4.0",
        "eslint-plugin-vue": "^10.9.1",
        "lint-staged": "^16.4.0",
        "postcss": "^8.5.6",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.1.11",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.3",
        "vite": "^7.1.7",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.9"
    },
    "lint-staged": {
        "*.{ts,vue,js,cjs,mjs}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md,css,html}": "prettier --write"
    }
}
