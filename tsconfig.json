{
    "compilerOptions": {
        "strict": true,
        "useDefineForClassFields": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "allowJs": true,
        "experimentalDecorators": true,

        "target": "ES2022",
        "module": "ESNext", // safer than ES2022 for Vite + Vue

        "jsx": "preserve",
        "lib": ["ESNext", "DOM"],

        "types": ["node", "vite/client", "vue"],

        "paths": {
            "@/*": ["./src/*"],
            "@ui/*": ["../../fi-ui-toolkit/*"],
            "@ui_v3/*": ["../../fi-ui-toolkit/version_3/*"]
        },

        "noEmit": true,
        "moduleResolution": "bundler"
    },
    // "vueCompilerOptions": {
    //   "globalTypesPath": "./src/types/shims-vue.d.ts"
    // },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.vue",
        "../../fi-ui-toolkit/version_3/**/*.ts",
        "../../fi-ui-toolkit/version_3/**/*.d.ts",
        "../../fi-ui-toolkit/version_3/**/*.vue"
    ],
    "exclude": ["node_modules", "dist", "test"]
}
